CI_ENV=development
APP_BASE_URL=http://localhost/mi_proyecto/
APP_ENCRYPTION_KEY=cambia_esta_clave_por_una_unica
APP_EMAIL_USERAGENT=mi_proyecto

# TLS CA bundle for Stripe/BTCPay outbound requests.
# Windows/XAMPP example:
# CURL_CA_BUNDLE=C:/xampp/apache/bin/curl-ca-bundle.crt
# Windows/IIS example:
# CURL_CA_BUNDLE=C:/Program Files/Common Files/SSL/cert.pem
# Linux example:
# CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
CURL_CA_BUNDLE=

SESSION_DRIVER=files
SESSION_COOKIE_NAME=ci_session
SESSION_EXPIRATION=7200
SESSION_SAVE_PATH=null
SESSION_MATCH_IP=false
SESSION_TIME_TO_UPDATE=300
SESSION_REGENERATE_DESTROY=false

COOKIE_PREFIX=
COOKIE_DOMAIN=
COOKIE_PATH=/
COOKIE_SECURE=false
COOKIE_HTTPONLY=false

SIMULATED_CLIENT_IP=

DB_DSN=
DB_HOSTNAME=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=mi_base_de_datos
DB_DRIVER=mysqli
DB_PREFIX=
DB_PCONNECT=false
DB_CACHE_ON=false
DB_CACHE_DIR=
DB_CHARSET=utf8
DB_COLLATION=utf8_unicode_ci
DB_SWAP_PREFIX=
DB_ENCRYPT=false
DB_COMPRESS=false
DB_STRICT_ON=false
DB_SAVE_QUERIES=true

# Multi-tenant (M01)
# Dominio base para construir subdominios: <slug>.<TENANT_BASE_DOMAIN>
TENANT_BASE_DOMAIN=sortea2.net
# Resolución por path /sitio/<slug> y ?org=<slug>. SOLO desarrollo.
# En producción debe permanecer en false.
TENANT_ALLOW_PATH_RESOLUTION=true
# Producción:
#   CI_ENV=production  (desactiva db_debug y oculta errores de BD)
#   COOKIE_SECURE=true
#   COOKIE_DOMAIN=     (vacío: sesión host-only, no compartida entre tenants)
# Requisito operativo: DNS wildcard *.TENANT_BASE_DOMAIN apuntando al docroot.
