<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  proyecto_base — IIS (Windows Server)
  Equivalente a .htaccess (Apache local)
  Requiere el módulo URL Rewrite de IIS instalado.
  ============================================================================
-->
<configuration>
  <system.webServer>

    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <rewrite>
      <rules>
        <!-- 1. Bloquear directorios sensibles -->
        <rule name="BlockSensitiveDirectories" stopProcessing="true">
          <match url="^(database|\.git|application|system|upload)(/|$)" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusDescription="Forbidden" />
        </rule>

        <!-- 2. Bloquear archivos sensibles (secretos, migraciones, documentación) -->
        <rule name="BlockSensitiveFiles" stopProcessing="true">
          <match url="(^|/)(\.env(\..*)?|composer\.(json|lock)|MEMORY\.md|web\.config|AGENTS\.md|README\.md|[^/]+\.(sql|md|ini|log|lock|bak|dist|swp|swo|orig|save|old))$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusDescription="Forbidden" />
        </rule>

        <!-- 3. Front controller de CodeIgniter 3 -->
        <rule name="CodeIgniter" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="application" />
          <add segment="system" />
          <add segment="database" />
          <add segment=".git" />
          <add segment="upload" />
          <add segment="MEMORY.md" />
          <add segment="AGENTS.md" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".ini" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".lock" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".dist" allowed="false" />
          <add fileExtension=".swp" allowed="false" />
          <add fileExtension=".old" allowed="false" />
        </fileExtensions>
        <!-- No permitir subir/ejecutar scripts desde upload -->
        <requestLimits maxAllowedContentLength="10485760" />
      </requestFiltering>
    </security>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=()" />
        <add name="X-Permitted-Cross-Domain-Policies" value="none" />
        <add name="Cross-Origin-Opener-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
    </staticContent>

  </system.webServer>
</configuration>
